NODE_ENV=development
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://mongo:27017/ojx
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-32-character-minimum-secret-here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-32-char-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
